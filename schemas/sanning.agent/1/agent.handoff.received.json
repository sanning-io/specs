{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanning.io/specs/schemas/sanning.agent/1/agent.handoff.received.json",
  "title": "agent.handoff.received",
  "description": "The event record of one agent.handoff.received record under sanning.agent/1. Normative text: agent-events.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_version",
    "spec_version",
    "event_type",
    "subject",
    "previous_hash",
    "event",
    "context",
    "metadata",
    "extras"
  ],
  "properties": {
    "payload_version": {
      "const": 1
    },
    "spec_version": {
      "const": "sanning.events/v2"
    },
    "event_type": {
      "const": "agent.handoff.received"
    },
    "subject": {
      "$ref": "common.json#/$defs/subject"
    },
    "previous_hash": {
      "$ref": "common.json#/$defs/previous_hash"
    },
    "event": {
      "$ref": "common.json#/$defs/handoff_event_received"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_mode",
        "salt"
      ],
      "properties": {
        "data_mode": {
          "$ref": "common.json#/$defs/data_mode"
        },
        "salt": {
          "$ref": "common.json#/$defs/salt"
        },
        "case_id": {
          "$ref": "common.json#/$defs/id"
        },
        "chain_key": {
          "$ref": "common.json#/$defs/id"
        },
        "in_reply_to": {
          "$ref": "common.json#/$defs/sha256_either_case"
        },
        "protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "unchecked_held_part_count": {
          "$ref": "common.json#/$defs/pos_int"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "otel",
        "handoff"
      ],
      "properties": {
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "parent_run_id",
            "root_run_id",
            "seq",
            "prev_event_id"
          ],
          "properties": {
            "run_id": {
              "$ref": "common.json#/$defs/id"
            },
            "parent_run_id": {
              "$ref": "common.json#/$defs/id_or_null"
            },
            "root_run_id": {
              "$ref": "common.json#/$defs/id"
            },
            "seq": {
              "$ref": "common.json#/$defs/uint"
            },
            "prev_event_id": {
              "$ref": "common.json#/$defs/event_id_or_null"
            },
            "source_type": {
              "$ref": "common.json#/$defs/label"
            }
          },
          "not": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "seq",
                  "prev_event_id"
                ],
                "properties": {
                  "seq": {
                    "const": 0
                  },
                  "prev_event_id": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "seq",
                  "prev_event_id"
                ],
                "properties": {
                  "seq": {
                    "not": {
                      "const": 0
                    }
                  },
                  "prev_event_id": {
                    "const": null
                  }
                }
              }
            ]
          }
        },
        "otel": {
          "$ref": "common.json#/$defs/otel"
        },
        "gen_ai": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "agent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version"
              ],
              "properties": {
                "version": {
                  "$ref": "common.json#/$defs/label"
                }
              }
            },
            "conversation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "$ref": "common.json#/$defs/id"
                }
              }
            }
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not_captured"
          ],
          "properties": {
            "not_captured": {
              "type": "array",
              "minItems": 1,
              "maxItems": 19,
              "uniqueItems": true,
              "items": {
                "$ref": "common.json#/$defs/agent_type"
              }
            }
          }
        },
        "handoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parts",
            "file_parts"
          ],
          "properties": {
            "parts": {
              "$ref": "common.json#/$defs/uint"
            },
            "file_parts": {
              "$ref": "common.json#/$defs/uint"
            },
            "sent_event_id": {
              "$ref": "common.json#/$defs/event_id"
            },
            "unchecked_held_parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "uniqueItems": true,
              "items": {
                "$ref": "common.json#/$defs/uint"
              }
            }
          }
        }
      }
    },
    "extras": {
      "$ref": "common.json#/$defs/extras"
    }
  },
  "not": {
    "required": [
      "previous_hash",
      "context"
    ],
    "properties": {
      "previous_hash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "context": {
        "type": "object",
        "not": {
          "properties": {
            "chain_key": true
          },
          "required": [
            "chain_key"
          ]
        }
      }
    }
  }
}
