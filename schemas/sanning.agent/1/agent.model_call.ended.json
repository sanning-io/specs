{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanning.io/specs/schemas/sanning.agent/1/agent.model_call.ended.json",
  "title": "agent.model_call.ended",
  "description": "The event record of one agent.model_call.ended record under sanning.agent/1. Normative text: agent-events.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_version",
    "spec_version",
    "event_type",
    "subject",
    "previous_hash",
    "event",
    "context",
    "metadata",
    "extras"
  ],
  "properties": {
    "payload_version": {
      "const": 1
    },
    "spec_version": {
      "const": "sanning.events/v2"
    },
    "event_type": {
      "const": "agent.model_call.ended"
    },
    "subject": {
      "$ref": "common.json#/$defs/subject"
    },
    "previous_hash": {
      "$ref": "common.json#/$defs/previous_hash"
    },
    "event": {
      "$ref": "common.json#/$defs/content_event"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_mode",
        "salt"
      ],
      "properties": {
        "data_mode": {
          "$ref": "common.json#/$defs/data_mode"
        },
        "salt": {
          "$ref": "common.json#/$defs/salt"
        },
        "case_id": {
          "$ref": "common.json#/$defs/id"
        },
        "chain_key": {
          "$ref": "common.json#/$defs/id"
        },
        "content_scrubbed": {
          "const": true
        },
        "revealed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "gen_ai.output.messages",
              "exception.message"
            ]
          }
        },
        "hidden": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "run.name": {
              "$ref": "common.json#/$defs/sha256"
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "otel",
        "gen_ai",
        "outcome"
      ],
      "properties": {
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "parent_run_id",
            "root_run_id",
            "seq",
            "prev_event_id",
            "started_event_id"
          ],
          "properties": {
            "run_id": {
              "$ref": "common.json#/$defs/id"
            },
            "parent_run_id": {
              "$ref": "common.json#/$defs/id_or_null"
            },
            "root_run_id": {
              "$ref": "common.json#/$defs/id"
            },
            "seq": {
              "$ref": "common.json#/$defs/uint"
            },
            "prev_event_id": {
              "$ref": "common.json#/$defs/event_id_or_null"
            },
            "source_type": {
              "$ref": "common.json#/$defs/label"
            },
            "name": {
              "$ref": "common.json#/$defs/text"
            },
            "client": {
              "$ref": "common.json#/$defs/label"
            },
            "started_event_id": {
              "$ref": "common.json#/$defs/event_id_or_null"
            },
            "observed_started_at": {
              "$ref": "common.json#/$defs/rfc3339_utc"
            }
          },
          "not": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "seq",
                  "prev_event_id"
                ],
                "properties": {
                  "seq": {
                    "const": 0
                  },
                  "prev_event_id": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "seq",
                  "prev_event_id"
                ],
                "properties": {
                  "seq": {
                    "not": {
                      "const": 0
                    }
                  },
                  "prev_event_id": {
                    "const": null
                  }
                }
              }
            ]
          }
        },
        "otel": {
          "$ref": "common.json#/$defs/otel"
        },
        "gen_ai": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "$ref": "common.json#/$defs/model_operation"
                }
              }
            },
            "agent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version"
              ],
              "properties": {
                "version": {
                  "$ref": "common.json#/$defs/label"
                }
              }
            },
            "conversation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "$ref": "common.json#/$defs/id"
                }
              }
            },
            "provider": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "$ref": "common.json#/$defs/provider_name"
                }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "model": {
                  "$ref": "common.json#/$defs/text"
                },
                "id": {
                  "$ref": "common.json#/$defs/provider_id"
                },
                "finish_reasons": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "common.json#/$defs/label"
                  }
                }
              }
            },
            "usage": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "input_tokens": {
                  "$ref": "common.json#/$defs/uint"
                },
                "output_tokens": {
                  "$ref": "common.json#/$defs/uint"
                },
                "reasoning": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "output_tokens"
                  ],
                  "properties": {
                    "output_tokens": {
                      "$ref": "common.json#/$defs/uint"
                    }
                  }
                }
              }
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "messages": {
                  "$ref": "common.json#/$defs/any"
                }
              }
            }
          }
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "$ref": "common.json#/$defs/outcome_status"
            }
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "$ref": "common.json#/$defs/label"
            }
          }
        },
        "exception": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "message": {
              "$ref": "common.json#/$defs/string"
            }
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not_captured"
          ],
          "properties": {
            "not_captured": {
              "type": "array",
              "minItems": 1,
              "maxItems": 19,
              "uniqueItems": true,
              "items": {
                "$ref": "common.json#/$defs/agent_type"
              }
            }
          }
        },
        "openai": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "response"
          ],
          "properties": {
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "system_fingerprint"
              ],
              "properties": {
                "system_fingerprint": {
                  "$ref": "common.json#/$defs/label"
                }
              }
            }
          }
        }
      }
    },
    "extras": {
      "$ref": "common.json#/$defs/extras"
    }
  },
  "not": {
    "required": [
      "previous_hash",
      "context"
    ],
    "properties": {
      "previous_hash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "context": {
        "type": "object",
        "not": {
          "properties": {
            "chain_key": true
          },
          "required": [
            "chain_key"
          ]
        }
      }
    }
  }
}
