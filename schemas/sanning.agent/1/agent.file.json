{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanning.io/specs/schemas/sanning.agent/1/agent.file.json",
  "title": "agent.file",
  "description": "The event record of one agent.file record under sanning.agent/1. Normative text: agent-events.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_version",
    "spec_version",
    "event_type",
    "subject",
    "previous_hash",
    "event",
    "context",
    "metadata",
    "extras"
  ],
  "properties": {
    "payload_version": {
      "const": 1
    },
    "spec_version": {
      "const": "sanning.events/v2"
    },
    "event_type": {
      "const": "agent.file"
    },
    "subject": {
      "$ref": "common.json#/$defs/subject"
    },
    "previous_hash": {
      "$ref": "common.json#/$defs/previous_hash"
    },
    "event": {
      "$ref": "common.json#/$defs/content_event"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_mode",
        "salt"
      ],
      "properties": {
        "data_mode": {
          "$ref": "common.json#/$defs/data_mode"
        },
        "salt": {
          "$ref": "common.json#/$defs/salt"
        },
        "case_id": {
          "$ref": "common.json#/$defs/id"
        },
        "chain_key": {
          "$ref": "common.json#/$defs/id"
        },
        "hidden": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "artifact.name": {
              "$ref": "common.json#/$defs/sha256"
            },
            "artifact.path": {
              "$ref": "common.json#/$defs/sha256"
            },
            "artifact.source": {
              "$ref": "common.json#/$defs/sha256"
            },
            "artifact.destination": {
              "$ref": "common.json#/$defs/sha256"
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "otel",
        "outcome"
      ],
      "properties": {
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "parent_run_id",
            "root_run_id",
            "seq",
            "prev_event_id"
          ],
          "properties": {
            "run_id": {
              "$ref": "common.json#/$defs/id"
            },
            "parent_run_id": {
              "$ref": "common.json#/$defs/id_or_null"
            },
            "root_run_id": {
              "$ref": "common.json#/$defs/id"
            },
            "seq": {
              "$ref": "common.json#/$defs/uint"
            },
            "prev_event_id": {
              "$ref": "common.json#/$defs/event_id_or_null"
            },
            "source_type": {
              "$ref": "common.json#/$defs/label"
            }
          },
          "not": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "seq",
                  "prev_event_id"
                ],
                "properties": {
                  "seq": {
                    "const": 0
                  },
                  "prev_event_id": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "seq",
                  "prev_event_id"
                ],
                "properties": {
                  "seq": {
                    "not": {
                      "const": 0
                    }
                  },
                  "prev_event_id": {
                    "const": null
                  }
                }
              }
            ]
          }
        },
        "otel": {
          "$ref": "common.json#/$defs/otel"
        },
        "gen_ai": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "agent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version"
              ],
              "properties": {
                "version": {
                  "$ref": "common.json#/$defs/label"
                }
              }
            },
            "conversation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "$ref": "common.json#/$defs/id"
                }
              }
            }
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not_captured"
          ],
          "properties": {
            "not_captured": {
              "type": "array",
              "minItems": 1,
              "maxItems": 19,
              "uniqueItems": true,
              "items": {
                "$ref": "common.json#/$defs/agent_type"
              }
            }
          }
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "$ref": "common.json#/$defs/file_status"
            }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "name": {
              "$ref": "common.json#/$defs/text"
            },
            "tool_call_event_id": {
              "$ref": "common.json#/$defs/event_id"
            },
            "byte_length": {
              "$ref": "common.json#/$defs/uint"
            },
            "content_type": {
              "$ref": "common.json#/$defs/label"
            },
            "role": {
              "$ref": "common.json#/$defs/artifact_role"
            },
            "reason": {
              "$ref": "common.json#/$defs/artifact_reason"
            },
            "path": {
              "$ref": "common.json#/$defs/locator"
            },
            "source": {
              "$ref": "common.json#/$defs/locator"
            },
            "destination": {
              "$ref": "common.json#/$defs/locator"
            }
          }
        }
      }
    },
    "extras": {
      "$ref": "common.json#/$defs/extras"
    }
  },
  "not": {
    "required": [
      "previous_hash",
      "context"
    ],
    "properties": {
      "previous_hash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "context": {
        "type": "object",
        "not": {
          "properties": {
            "chain_key": true
          },
          "required": [
            "chain_key"
          ]
        }
      }
    }
  }
}
