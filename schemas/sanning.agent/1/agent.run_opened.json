{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanning.io/specs/schemas/sanning.agent/1/agent.run_opened.json",
  "title": "agent.run_opened",
  "description": "The event record of one agent.run_opened record under sanning.agent/1. Normative text: agent-events.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_version",
    "spec_version",
    "event_type",
    "subject",
    "previous_hash",
    "event",
    "context",
    "metadata",
    "extras"
  ],
  "properties": {
    "payload_version": {
      "const": 1
    },
    "spec_version": {
      "const": "sanning.events/v2"
    },
    "event_type": {
      "const": "agent.run_opened"
    },
    "subject": {
      "$ref": "common.json#/$defs/subject"
    },
    "previous_hash": {
      "$ref": "common.json#/$defs/previous_hash"
    },
    "event": {
      "$ref": "common.json#/$defs/content_event"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_mode",
        "salt"
      ],
      "properties": {
        "data_mode": {
          "$ref": "common.json#/$defs/data_mode"
        },
        "salt": {
          "$ref": "common.json#/$defs/salt"
        },
        "case_id": {
          "$ref": "common.json#/$defs/id"
        },
        "chain_key": {
          "$ref": "common.json#/$defs/id"
        },
        "content_scrubbed": {
          "const": true
        },
        "revealed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "authority.principal"
            ]
          }
        },
        "hidden": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "run.name": {
              "$ref": "common.json#/$defs/sha256"
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "otel",
        "gen_ai",
        "closing"
      ],
      "properties": {
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "parent_run_id",
            "root_run_id",
            "seq",
            "prev_event_id"
          ],
          "properties": {
            "run_id": {
              "$ref": "common.json#/$defs/id"
            },
            "parent_run_id": {
              "$ref": "common.json#/$defs/id_or_null"
            },
            "root_run_id": {
              "$ref": "common.json#/$defs/id"
            },
            "seq": {
              "const": 0
            },
            "prev_event_id": {
              "const": null
            },
            "source_type": {
              "$ref": "common.json#/$defs/label"
            },
            "name": {
              "$ref": "common.json#/$defs/text"
            },
            "runner_event_id": {
              "$ref": "common.json#/$defs/event_id"
            },
            "handoff_event_id": {
              "$ref": "common.json#/$defs/event_id"
            }
          }
        },
        "otel": {
          "$ref": "common.json#/$defs/otel"
        },
        "gen_ai": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "const": "invoke_agent"
                }
              }
            },
            "agent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version"
              ],
              "properties": {
                "version": {
                  "$ref": "common.json#/$defs/label"
                }
              }
            },
            "conversation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "$ref": "common.json#/$defs/id"
                }
              }
            }
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not_captured"
          ],
          "properties": {
            "not_captured": {
              "type": "array",
              "minItems": 1,
              "maxItems": 19,
              "uniqueItems": true,
              "items": {
                "$ref": "common.json#/$defs/agent_type"
              }
            }
          }
        },
        "closing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "promised"
          ],
          "properties": {
            "promised": {
              "const": true
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "scope": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "common.json#/$defs/label"
              }
            },
            "expires_at": {
              "$ref": "common.json#/$defs/rfc3339_utc"
            },
            "principal": {
              "$ref": "common.json#/$defs/any"
            }
          }
        }
      }
    },
    "extras": {
      "$ref": "common.json#/$defs/extras"
    }
  },
  "not": {
    "required": [
      "previous_hash",
      "context"
    ],
    "properties": {
      "previous_hash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "context": {
        "type": "object",
        "not": {
          "properties": {
            "chain_key": true
          },
          "required": [
            "chain_key"
          ]
        }
      }
    }
  }
}
